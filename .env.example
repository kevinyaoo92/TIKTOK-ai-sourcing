# ============================================================
# Thailand TikTok Opportunity - 环境变量示例
# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略，严禁提交真实密钥。
# 第一阶段(数据采集+机会分析)不需要任何 API Key，以下默认值即可运行。
# ============================================================

# ---- DeepSeek (第二阶段 AI 语义模块才启用；第一阶段默认 false，流水线不调用 AI) ----
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 可选覆盖：数据/库路径与采集默认值（不填则用代码内默认） ----
# DATABASE_PATH=D:\tiktok-ai-sourcing\database\opportunity.db
# TIKTOK_MARKET=TH
# TIKTOK_CATEGORY=时尚配件
# TIKTOK_KEYWORD_TYPE=热门搜索关键词
# TIKTOK_PERIOD_TYPE=month
