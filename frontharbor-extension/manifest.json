{
  "manifest_version": 3,
  "name": "Frontharbor 找货助手",
  "version": "0.4.0",
  "description": "在您自己的 1688 账号下自动寻找优质货源，结果回传 Frontharbor。",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8123/*",
    "http://118.89.85.175/*",
    "https://s.1688.com/*",
    "https://detail.1688.com/*",
    "https://erp.91miaoshou.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Frontharbor 找货助手"
  }
}
