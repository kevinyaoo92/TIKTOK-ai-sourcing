{
  "manifest_version": 3,
  "name": "Frontharbor 找货助手 (POC-3A)",
  "version": "0.3.0",
  "description": "POC-3A：验证扩展能否读取 1688 详情页 window.context 数据。",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8123/*",
    "http://118.89.85.175/*",
    "https://s.1688.com/*",
    "https://detail.1688.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Frontharbor POC-3A"
  }
}
